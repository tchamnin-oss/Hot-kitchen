rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDayQty(val) {
      return val == null || ((val is int || val is float) && val >= 0 && val <= 1000000);
    }

    function isValidKitchen(data) {
      return data.keys().hasAll(['workspaceId', 'weekStart', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['workspaceId', 'weekStart', 'createdAt', 'updatedAt'])
        && data.workspaceId is string
        && data.workspaceId == 'hot_kitchen'
        && data.weekStart is string
        && data.weekStart.size() == 10
        && data.weekStart.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStockItem(data) {
      return data.keys().hasAll([
          'workspaceId', 'sortOrder', 'category', 'item', 'unit',
          'mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'sortOrder', 'category', 'item', 'unit',
          'mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun',
          'createdAt', 'updatedAt'
        ])
        && data.workspaceId is string
        && data.workspaceId == 'hot_kitchen'
        && (data.sortOrder is int || data.sortOrder is float)
        && data.sortOrder >= 0
        && data.sortOrder <= 100000
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 80
        && data.item is string
        && data.item.size() >= 1
        && data.item.size() <= 160
        && data.unit is string
        && data.unit.size() >= 1
        && data.unit.size() <= 40
        && isValidDayQty(data.mon)
        && isValidDayQty(data.tue)
        && isValidDayQty(data.wed)
        && isValidDayQty(data.thu)
        && isValidDayQty(data.fri)
        && isValidDayQty(data.sat)
        && isValidDayQty(data.sun)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function kitchenExists(kitchenId) {
      return kitchenId == 'hot_kitchen'
        && exists(/databases/$(database)/documents/kitchens/$(kitchenId));
    }

    match /kitchens/{kitchenId} {
      allow get: if isValidId(kitchenId) && kitchenId == 'hot_kitchen';

      allow list: if false;

      allow create: if isValidId(kitchenId)
        && kitchenId == 'hot_kitchen'
        && isValidKitchen(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(kitchenId)
        && kitchenId == 'hot_kitchen'
        && isValidKitchen(incoming())
        && incoming().workspaceId == existing().workspaceId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['weekStart', 'updatedAt']);

      allow delete: if false;

      match /items/{itemId} {
        allow get: if isValidId(kitchenId)
          && kitchenId == 'hot_kitchen'
          && isValidId(itemId)
          && kitchenExists(kitchenId);

        allow list: if kitchenId == 'hot_kitchen'
          && existing().workspaceId == 'hot_kitchen';

        allow create: if isValidId(kitchenId)
          && kitchenId == 'hot_kitchen'
          && isValidId(itemId)
          && isValidStockItem(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && kitchenExists(kitchenId);

        allow update: if isValidId(kitchenId)
          && kitchenId == 'hot_kitchen'
          && isValidId(itemId)
          && isValidStockItem(incoming())
          && incoming().workspaceId == existing().workspaceId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && kitchenExists(kitchenId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun', 'updatedAt'
            ])
            || incoming().diff(existing()).affectedKeys().hasOnly([
              'category', 'item', 'unit', 'sortOrder', 'updatedAt'
            ])
          );

        allow delete: if isValidId(kitchenId)
          && kitchenId == 'hot_kitchen'
          && isValidId(itemId)
          && existing().workspaceId == 'hot_kitchen'
          && kitchenExists(kitchenId);
      }
    }
  }
}
