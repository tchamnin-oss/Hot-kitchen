      { id: 38, category: "MEAT", item: "Kimchi Arancini", unit: "PORTION", mon: "", tue: "", wed: "", thu: "", fri: "", sat: "", sun: "" },

      // DRY STORE
      { id: 39, category: "DRY STORE", item: "Tomato Peel", unit: "CAN", mon: "", tue: "", wed: "", thu: "", fri: "", sat: "", sun: "" },
      { id: 40, category: "DRY STORE", item: "Spaghetti", unit: "PACK", mon: "", tue: "", wed: "", thu: "", fri: "", sat: "", sun: "" },
      { id: 41, category: "DRY STORE", item: "Black Ink Spaghetti", unit: "PACK", mon: "", tue: "", wed: "", thu: "", fri: "", sat: "", sun: "" },
      { id: 42, category: "DRY STORE", item: "Penne", unit: "PACK", mon: "", tue: "", wed: "", thu: "", fri: "", sat: "", sun: "" },
      { id: 43, category: "DRY STORE", item: "Pomace Olive Oil", unit: "GALLON", mon: "", tue: "", wed: "", thu: "", fri: "", sat: "", sun: "" },
      { id: 44, category: "DRY STORE", item: "Palm Oil", unit: "GALLON", mon: "", tue: "", wed: "", thu: "", fri: "", sat: "", sun: "" },
    ];

    let currentCategory = 'ALL';
    let stockData = JSON.parse(localStorage.getItem('hot_kitchen_par_stock_v2')) || defaultData;

    // Week Date Range Management
    const defaultMonday = "2026-11-16";
    let weekStart = localStorage.getItem('hot_kitchen_par_week_start') || defaultMonday;

    function getMonday(dateInput) {
      const d = new Date(dateInput);
      const day = d.getDay();
      const diff = d.getDate() - day + (day === 0 ? -6 : 1); // Adjust when day is Sunday
      const monday = new Date(d.setDate(diff));
      return formatDateToYMD(monday);
    }

    function formatDateToYMD(d) {
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    function addDays(dateStr, days) {
      const [y, m, d] = dateStr.split('-').map(Number);
      const date = new Date(y, m - 1, d);
      date.setDate(date.getDate() + days);
      return formatDateToYMD(date);
    }

    function formatDisplayDate(dateStr) {
      const [y, m, d] = dateStr.split('-').map(Number);
      return `${String(d).padStart(2, '0')}/${String(m).padStart(2, '0')}/${y}`;
    }

    function formatShortDate(dateStr) {
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      const [y, m, d] = dateStr.split('-').map(Number);
      return `${d} ${months[m - 1]}`;
    }

    function getWeekDates() {
      return {
        mon: weekStart,
        tue: addDays(weekStart, 1),
        wed: addDays(weekStart, 2),
        thu: addDays(weekStart, 3),
        fri: addDays(weekStart, 4),
        sat: addDays(weekStart, 5),
        sun: addDays(weekStart, 6)
      };
    }

    function updateWeekDisplay() {
      const dates = getWeekDates();
      const rangeText = `${formatDisplayDate(dates.mon)} - ${formatDisplayDate(dates.sun)}`;
      const rangeDisplay = document.getElementById('weekDisplayRange');
      if (rangeDisplay) rangeDisplay.textContent = rangeText;

      const dateInput = document.getElementById('weekStartDateInput');
      if (dateInput) dateInput.value = weekStart;

      // Update table column headers
      const days = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];
      days.forEach(day => {
        const span = document.getElementById(`header-date-${day}`);
        if (span) {
          span.textContent = formatShortDate(dates[day]);
        }
      });
    }

    function onStartDateChange(val) {
      if (!val) return;
      weekStart = getMonday(val);
      localStorage.setItem('hot_kitchen_par_week_start', weekStart);
      updateWeekDisplay();
      showToast(`เปลี่ยนรอบสัปดาห์เป็น ${formatDisplayDate(weekStart)} แล้ว`);
    }

    function changeWeek(direction) {
      weekStart = addDays(weekStart, direction * 7);
      localStorage.setItem('hot_kitchen_par_week_start', weekStart);
      updateWeekDisplay();
      showToast(`เปลี่ยนเป็นรอบ ${formatDisplayDate(weekStart)}`);
    }

    function saveState(msg = 'บันทึกข้อมูลเรียบร้อยแล้ว') {
      localStorage.setItem('hot_kitchen_par_stock_v2', JSON.stringify(stockData));
      updateStats();
      showToast(msg);
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMessage');
      if (toastMsg && msg) toastMsg.textContent = msg;
      toast.classList.remove('opacity-0', 'pointer-events-none');
      toast.classList.add('opacity-100');
      setTimeout(() => {
        toast.classList.remove('opacity-100');
        toast.classList.add('opacity-0', 'pointer-events-none');
      }, 1600);
    }

    function calculateTotal(row) {
      const days = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];
      return days.reduce((sum, d) => sum + (parseFloat(row[d]) || 0), 0);
    }

    function updateStock(id, day, value) {
      const item = stockData.find(d => d.id === id);
      if (item) {
        item[day] = value === '' ? '' : Number(value);
        saveState();
        const totalCell = document.getElementById(`total-${id}`);
        if (totalCell) {
          const total = calculateTotal(item);
          totalCell.textContent = total > 0 ? total : '-';
        }
      }
    }

    function getUniqueCategories() {
      const cats = new Set(stockData.map(d => d.category));
      return Array.from(cats);
    }

    function renderCategoryTabs() {
      const container = document.getElementById('categoryTabs');
      if (!container) return;
      const cats = getUniqueCategories();
      
      let html = `<button onclick="filterCategory('ALL')" class="cat-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap ${currentCategory === 'ALL' ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'} transition" data-cat="ALL">ทั้งหมด (${stockData.length})</button>`;
      
      cats.forEach(c => {
        const count = stockData.filter(i => i.category === c).length;
        const isActive = currentCategory === c;
        html += `<button onclick="filterCategory('${c}')" class="cat-btn px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap ${isActive ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'} transition" data-cat="${c}">${c} (${count})</button>`;
      });

      container.innerHTML = html;

      // Update Modal Categories dropdown
      const modalSelect = document.getElementById('modalCategorySelect');
      if (modalSelect) {
        let optHtml = '';
        cats.forEach(c => {
          optHtml += `<option value="${c}">${c}</option>`;
        });
        optHtml += `<option value="CUSTOM">+ เพิ่มหมวดหมู่ใหม่...</option>`;
        modalSelect.innerHTML = optHtml;
      }
    }

    function filterCategory(cat) {
      currentCategory = cat;
      renderCategoryTabs();
      renderTable();
    }

    function updateStats() {
      const totalItems = stockData.length;
      const badge = document.getElementById('itemCountBadge');
      if (badge) badge.textContent = `${totalItems} รายการ`;
    }

    function renderTable() {
      const tbody = document.getElementById('stockTableBody');
      const searchInput = document.getElementById('searchInput');
      const search = searchInput ? searchInput.value.toLowerCase().trim() : '';
      tbody.innerHTML = '';

      let lastCategory = '';

      const filtered = stockData.filter(item => {
        const matchCategory = (currentCategory === 'ALL' || item.category === currentCategory);
        const matchSearch = item.item.toLowerCase().includes(search) || item.unit.toLowerCase().includes(search);
        return matchCategory && matchSearch;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="12" class="text-center py-10 text-slate-400">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-package-search mx-auto mb-2 opacity-50"><path d="M21 10V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l2-1.14"></path><path d="m7.5 4.27 9 5.15"></path><polyline points="3.29 7 12 12 20.71 7"></polyline><line x1="12" x2="12" y1="22" y2="12"></line><circle cx="18.5" cy="15.5" r="2.5"></circle><path d="M20.27 17.27 22 19"></path></svg>
          <div>ไม่พบรายการวัตถุดิบที่ค้นหา</div>
        </td></tr>`;
        lucide.createIcons();
        return;
      }

      filtered.forEach((row, index) => {
        // Show category section header
        if (currentCategory === 'ALL' && row.category !== lastCategory) {
          lastCategory = row.category;
          const catHeader = document.createElement('tr');
          catHeader.className = "bg-slate-100 font-bold text-slate-700 tracking-wider text-xs uppercase";
          catHeader.innerHTML = `<td colspan="12" class="py-2 px-4 bg-slate-200/70 border-y border-slate-300 font-bold text-slate-800 flex-1">
            <span class="inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder text-amber-600"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg> หมวดหมู่: ${row.category}</span>
          </td>`;
          tbody.appendChild(catHeader);
        }

        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50 transition border-b border-slate-100 group";

        const total = calculateTotal(row);

        tr.innerHTML = `
          <td class="py-2.5 px-3 text-center text-xs text-slate-400 font-medium">${index + 1}</td>
          <td class="py-2.5 px-4 font-semibold text-slate-800">
            <div class="flex items-center gap-2">
              <span>${row.item}</span>
              ${currentCategory !== 'ALL' ? '' : `<span class="text-[10px] bg-slate-100 text-slate-500 px-1.5 py-0.5 rounded font-normal hidden lg:inline">${row.category}</span>`}
            </div>
          </td>
          <td class="py-2.5 px-2 text-center">
            <span class="px-2 py-0.5 text-xs font-semibold bg-slate-100 text-slate-600 rounded border border-slate-200">${row.unit}</span>
          </td>
          
          ${['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'].map(day => `
            <td class="py-1 px-1 text-center">
              <input type="number" min="0" step="any"
                value="${row[day] !== undefined ? row[day] : ''}"
                onchange="updateStock(${row.id}, '${day}', this.value)"
                class="w-12 text-center py-1 text-sm rounded border border-slate-200 focus:bg-amber-50 focus:border-amber-500 focus:outline-none transition font-medium text-slate-700 hover:border-slate-300">
            </td>
          `).join('')}

          <td id="total-${row.id}" class="py-2.5 px-2 text-center font-bold text-slate-900 bg-slate-50 text-sm">
            ${total > 0 ? total : '-'}
          </td>
          <td class="py-2.5 px-2 text-center no-print">
            <button onclick="deleteItem(${row.id}, '${row.item.replace(/'/g, "\\'")}')" 
                    title="ลบวัตถุดิบนี้" 
                    class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition opacity-60 group-hover:opacity-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash-2"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg>
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      lucide.createIcons();
    }

    // Modal Operations
    function openAddItemModal() {
      document.getElementById('addItemModal').classList.remove('hidden');
      document.getElementById('addItemModal').classList.add('flex');
      document.getElementById('modalItemName').focus();
      lucide.createIcons();
    }

    function closeAddItemModal() {
      document.getElementById('addItemModal').classList.add('hidden');
      document.getElementById('addItemModal').classList.remove('flex');
      document.getElementById('addItemForm').reset();
      document.getElementById('modalCustomCategory').classList.add('hidden');
      document.getElementById('modalCustomUnit').classList.add('hidden');
    }

    function toggleCustomCategory(val) {
      const customInput = document.getElementById('modalCustomCategory');
      if (val === 'CUSTOM') {
        customInput.classList.remove('hidden');
        customInput.required = true;
        customInput.focus();
      } else {
        customInput.classList.add('hidden');
        customInput.required = false;
      }
    }

    function handleUnitSelect(val) {
      const customUnit = document.getElementById('modalCustomUnit');
      if (val === 'OTHER') {
        customUnit.classList.remove('hidden');
        customUnit.required = true;
        customUnit.focus();
      } else {
        customUnit.classList.add('hidden');
        customUnit.required = false;
      }
    }

    function handleAddItem(event) {
      event.preventDefault();
      
      const catSelect = document.getElementById('modalCategorySelect').value;
      const customCat = document.getElementById('modalCustomCategory').value.trim();
      const category = (catSelect === 'CUSTOM' ? customCat.toUpperCase() : catSelect) || 'GENERAL';

      const itemName = document.getElementById('modalItemName').value.trim();
      
      const unitSelect = document.getElementById('modalUnitSelect').value;
      const customUnit = document.getElementById('modalCustomUnit').value.trim();
      const unit = (unitSelect === 'OTHER' ? customUnit.toUpperCase() : unitSelect) || 'PCS';

      const initialQty = document.getElementById('modalInitialQty').value;

      if (!itemName) {
        alert('กรุณากรอกชื่อวัตถุดิบ');
        return;
      }

      const nextId = stockData.length > 0 ? Math.max(...stockData.map(d => d.id)) + 1 : 1;
      const newItem = {
        id: nextId,
        category: category,
        item: itemName,
        unit: unit,
        mon: initialQty !== '' ? Number(initialQty) : '',
        tue: '', wed: '', thu: '', fri: '', sat: '', sun: ''
      };

      stockData.push(newItem);
      saveState(`เพิ่มวัตถุดิบ "${itemName}" เรียบร้อยแล้ว`);
      closeAddItemModal();
      renderCategoryTabs();
      renderTable();
    }

    function deleteItem(id, name) {
      if (confirm(`คุณต้องการลบ "${name}" ออกจากรายการสต๊อกใช่หรือไม่?`)) {
        stockData = stockData.filter(d => d.id !== id);
        saveState(`ลบวัตถุดิบ "${name}" เรียบร้อยแล้ว`);
        renderCategoryTabs();
        renderTable();
      }
    }

    function exportToCSV() {
      const dates = getWeekDates();
      let csv = `\uFEFFPAR STOCK (HOT KITCHEN) [${formatDisplayDate(dates.mon)} - ${formatDisplayDate(dates.sun)}]\n`;
      csv += `ITEM,CATEGORY,UNIT,${dates.mon} (Mon),${dates.tue} (Tue),${dates.wed} (Wed),${dates.thu} (Thu),${dates.fri} (Fri),${dates.sat} (Sat),${dates.sun} (Sun),TOTAL\n`;

      let lastCat = '';
      stockData.forEach(row => {
        if (row.category !== lastCat) {
          lastCat = row.category;
          csv += `[${lastCat}],,,,,,,,,,,\n`;
        }
        const total = calculateTotal(row);
        const line = [
          `"${row.item.replace(/"/g, '""')}"`,
          `"${row.category}"`,
          `"${row.unit}"`,
          row.mon !== undefined ? row.mon : '',
          row.tue !== undefined ? row.tue : '',
          row.wed !== undefined ? row.wed : '',
          row.thu !== undefined ? row.thu : '',
          row.fri !== undefined ? row.fri : '',
          row.sat !== undefined ? row.sat : '',
          row.sun !== undefined ? row.sun : '',
          total
        ].join(',');
        csv += line + '\n';
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = `Par_Stock_Hot_Kitchen_${dates.mon}_to_${dates.sun}.csv`;
      link.click();
    }

    function resetData() {
      if (confirm("คุณแน่ใจหรือไม่ว่าต้องการรีเซ็ตข้อมูลทั้งหมดกลับเป็นค่าเริ่มต้น (44 รายการ)? การเพิ่ม/ลบรายการจะถูกรีเซ็ต")) {
        stockData = JSON.parse(JSON.stringify(defaultData));
        weekStart = defaultMonday;
        localStorage.setItem('hot_kitchen_par_week_start', weekStart);
        saveState('รีเซ็ตข้อมูลทั้งหมดเรียบร้อยแล้ว');
        updateWeekDisplay();
        renderCategoryTabs();
        renderTable();
      }
    }

    // ==========================================
    // SUMMARY REPORT & SAVE AS IMAGE FEATURES
    // ==========================================
    function openSummaryModal() {
      const dates = getWeekDates();
      const modal = document.getElementById('summaryModal');
      
      // Update Headers
      const reportWeekRange = document.getElementById('reportWeekRange');
      if (reportWeekRange) {
        reportWeekRange.textContent = `${formatDisplayDate(dates.mon)} - ${formatDisplayDate(dates.sun)}`;
      }

      const reportGeneratedTime = document.getElementById('reportGeneratedTime');
      if (reportGeneratedTime) {
        const now = new Date();
        reportGeneratedTime.textContent = `พิมพ์เมื่อ: ${now.toLocaleDateString('th-TH')} ${now.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' })}`;
      }

      // Compute KPIs
      const totalItems = stockData.length;
      let recordedCount = 0;
      let grandTotalQty = 0;

      stockData.forEach(item => {
        const itemTotal = calculateTotal(item);
        if (itemTotal > 0) {
          recordedCount++;
          grandTotalQty += itemTotal;
        }
      });

      const uniqueCats = getUniqueCategories();
      const activePercent = totalItems > 0 ? Math.round((recordedCount / totalItems) * 100) : 0;

      document.getElementById('kpiTotalItems').textContent = totalItems;
      document.getElementById('kpiActiveItems').textContent = recordedCount;
      document.getElementById('kpiActivePercent').textContent = `${activePercent}% ที่มีการบันทึกยอด`;
      document.getElementById('kpiTotalQuantity').textContent = grandTotalQty.toLocaleString();
      document.getElementById('kpiTotalCategories').textContent = uniqueCats.length;

      // Render Category Breakdown Tables
      const container = document.getElementById('reportCategoryBreakdown');
      container.innerHTML = '';

      uniqueCats.forEach(cat => {
        const catItems = stockData.filter(i => i.category === cat);
        const catTotalQty = catItems.reduce((acc, curr) => acc + calculateTotal(curr), 0);
        const catActiveCount = catItems.filter(i => calculateTotal(i) > 0).length;

        const catBlock = document.createElement('div');
        catBlock.className = "border border-slate-200 rounded-lg overflow-hidden";
        
        let rowsHtml = '';
        catItems.forEach((it, idx) => {
          const tot = calculateTotal(it);
          const hasCount = tot > 0;
          rowsHtml += `
            <tr class="${hasCount ? 'bg-amber-50/30' : 'bg-white'} border-b border-slate-100 text-xs">
              <td class="py-1.5 px-3 text-center text-slate-400 font-mono text-[11px]">${idx + 1}</td>
              <td class="py-1.5 px-3 font-semibold text-slate-800">${it.item}</td>
              <td class="py-1.5 px-2 text-center text-[11px] text-slate-500 font-medium">${it.unit}</td>
              <td class="py-1.5 px-1 text-center font-mono text-slate-600 ${it.mon ? 'font-bold text-amber-700' : ''}">${it.mon !== undefined && it.mon !== '' ? it.mon : '-'}</td>
              <td class="py-1.5 px-1 text-center font-mono text-slate-600 ${it.tue ? 'font-bold text-amber-700' : ''}">${it.tue !== undefined && it.tue !== '' ? it.tue : '-'}</td>
              <td class="py-1.5 px-1 text-center font-mono text-slate-600 ${it.wed ? 'font-bold text-amber-700' : ''}">${it.wed !== undefined && it.wed !== '' ? it.wed : '-'}</td>
              <td class="py-1.5 px-1 text-center font-mono text-slate-600 ${it.thu ? 'font-bold text-amber-700' : ''}">${it.thu !== undefined && it.thu !== '' ? it.thu : '-'}</td>
              <td class="py-1.5 px-1 text-center font-mono text-slate-600 ${it.fri ? 'font-bold text-amber-700' : ''}">${it.fri !== undefined && it.fri !== '' ? it.fri : '-'}</td>
              <td class="py-1.5 px-1 text-center font-mono text-slate-600 ${it.sat ? 'font-bold text-amber-700' : ''}">${it.sat !== undefined && it.sat !== '' ? it.sat : '-'}</td>
              <td class="py-1.5 px-1 text-center font-mono text-slate-600 ${it.sun ? 'font-bold text-amber-700' : ''}">${it.sun !== undefined && it.sun !== '' ? it.sun : '-'}</td>
              <td class="py-1.5 px-3 text-center font-bold ${hasCount ? 'text-slate-900 bg-amber-100/60' : 'text-slate-400 bg-slate-50'}">${tot > 0 ? tot : '-'}</td>
            </tr>
          `;
        });

        catBlock.innerHTML = `
          <div class="bg-slate-800 text-white px-3 py-2 flex items-center justify-between text-xs font-bold">
            <span class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-amber-400 inline-block"></span>
              ${cat} (${catItems.length} รายการ)
            </span>
            <span class="text-amber-300 font-semibold text-[11px]">
              บันทึกแล้ว ${catActiveCount}/${catItems.length} รายการ | รวม ${catTotalQty.toLocaleString()} หน่วย
            </span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-slate-100 text-slate-600 text-[10px] uppercase font-bold border-b border-slate-200">
                  <th class="py-1.5 px-3 text-center w-8">#</th>
                  <th class="py-1.5 px-3">ชื่อวัตถุดิบ (Item)</th>
                  <th class="py-1.5 px-2 text-center w-16">Unit</th>
                  <th class="py-1.5 px-1 text-center w-10">จ.</th>
                  <th class="py-1.5 px-1 text-center w-10">อ.</th>
                  <th class="py-1.5 px-1 text-center w-10">พ.</th>
                  <th class="py-1.5 px-1 text-center w-10">พฤ.</th>
                  <th class="py-1.5 px-1 text-center w-10">ศ.</th>
                  <th class="py-1.5 px-1 text-center w-10 bg-amber-100/50">ส.</th>
                  <th class="py-1.5 px-1 text-center w-10 bg-amber-100/50">อา.</th>
                  <th class="py-1.5 px-3 text-center w-16 bg-slate-200/80 font-black text-slate-800">รวม</th>
                </tr>
              </thead>
              <tbody>
                ${rowsHtml}
              </tbody>
            </table>
          </div>
        `;
        container.appendChild(catBlock);
      });

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      lucide.createIcons();
    }

    function closeSummaryModal() {
      const modal = document.getElementById('summaryModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function saveSummaryAsImage() {
      const reportElement = document.getElementById('summaryReportCard');
      const downloadBtn = document.getElementById('btnDownloadImage');
      const originalText = downloadBtn ? downloadBtn.innerHTML : '';
      
      if (downloadBtn) {
        downloadBtn.innerHTML = `
          <svg class="animate-spin w-3.5 h-3.5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          <span>กำลังสร้างภาพ...</span>
        `;
        downloadBtn.disabled = true;
      }

      showToast('กำลังประมวลผลรูปภาพ PNG ความละเอียดสูง...');

      // Render using html2canvas with scale 2 for crystal clear image
      html2canvas(reportElement, {
        scale: 2,
        useCORS: true,
        logging: false,
        backgroundColor: '#ffffff'
      }).then(canvas => {
        const link = document.createElement('a');
        const dates = getWeekDates();
        link.download = `Par_Stock_Summary_HotKitchen_${dates.mon}_to_${dates.sun}.png`;
        link.href = canvas.toDataURL('image/png');
        link.click();

        showToast('📸 ดาวน์โหลดรูปภาพสรุปยอดสำเร็จแล้ว!');
        if (downloadBtn) {
          downloadBtn.innerHTML = originalText;
          downloadBtn.disabled = false;
        }
      }).catch(err => {
        console.error('Snapshot error:', err);
        alert('เกิดข้อผิดพลาดในการบันทึกรูปภาพ กรุณาลองใหม่อีกครั้ง');
        if (downloadBtn) {
          downloadBtn.innerHTML = originalText;
          downloadBtn.disabled = false;
        }
      });
    }

    function printSummaryCard() {
      window.print();
    }

    // Initialize
    updateWeekDisplay();
    renderCategoryTabs();
    updateStats();
    renderTable();
    lucide.createIcons();
  </script>
